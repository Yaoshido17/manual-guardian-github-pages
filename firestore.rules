rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{commentId} {
      allow get: if resource.data.status == 'approved';
      allow list: if resource.data.status == 'approved'
        && request.query.limit <= 50;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['name', 'text', 'status', 'authorId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'text', 'status', 'authorId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /guideSuggestions/{suggestionId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['name', 'suggestion', 'status', 'authorId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'suggestion', 'status', 'authorId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() >= 5
        && request.resource.data.suggestion.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
